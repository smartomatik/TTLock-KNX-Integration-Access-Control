  {
    "id": "ttknx_fn_parse001",
    "type": "function",
    "z": "ttknx_tab0000001",
    "name": "Kto otworzył? → automatyka",
    "func": "// Odbiera callback TTLock \"Lock Records Notify\", filtruje i mapuje osobę na scenę.\n// Wyjścia: 1 = odpowiedź HTTP \"success\", 2 = scena KNX, 3 = tekst KNX,\n//          4 = wyzwalacz osoby (msg.miejsce 1–10), 5 = log\nconst TYPY = {\n    1: 'aplikacja (eKey)', 4: 'kod PIN', 7: 'karta/brelok RFID', 8: 'odcisk palca',\n    10: 'klucz mechaniczny', 11: 'zamknięcie z aplikacji', 12: 'zdalnie przez bramkę',\n    29: 'otwarcie siłowe', 32: 'otwarcie od środka', 44: 'sabotaż', 45: 'autozamykanie',\n    46: 'przycisk otwierania', 48: 'blokada po błędnych próbach', 55: 'pilot',\n    65: 'nieudane otwarcie', 92: 'kod administratora',\n};\nconst TYPY_PIN = [4, 34, 92]; // w tych rekordach keyboardPwd zawiera prawdziwy PIN\n\nfunction bezOgonkow(t) {\n    return String(t).replace(/ł/g, 'l').replace(/Ł/g, 'L')\n        .normalize('NFD').replace(/[̀-ͯ]/g, '');\n}\nfunction klucz(nazwa) {\n    return bezOgonkow(String(nazwa).trim().split(/[\\s\\-_–—.,]+/)[0] || '').toLowerCase();\n}\nfunction maskuj(r) {\n    const kopia = Object.assign({}, r);\n    if (TYPY_PIN.includes(Number(r.recordType)) && kopia.keyboardPwd) kopia.keyboardPwd = '****';\n    return kopia;\n}\n\n// TTLock oczekuje odpowiedzi \"success\" – odpowiadamy zawsze (także na testy bez msg.res)\nconst odpowiedz = msg.res ? { req: msg.req, res: msg.res, statusCode: 200,\n    headers: { 'Content-Type': 'text/plain' }, payload: 'success' } : null;\n\nconst cfg = flow.get('config');\nif (!cfg) {\n    node.warn('Brak konfiguracji – kliknij Deploy albo przycisk w węźle \"Wczytaj konfigurację\".');\n    return [odpowiedz, null, null, null, null];\n}\n\nconst body = msg.payload || {};\nconst lockId = String(body.lockId || '');\nif (cfg.lockId && lockId !== String(cfg.lockId)) {\n    return [odpowiedz, null, null, null, { payload: `Obcy lockId ${lockId} – zignorowano` }];\n}\nif (body.notifyType !== undefined && String(body.notifyType) !== '1') {\n    return [odpowiedz, null, null, null, { payload: `notifyType=${body.notifyType} (to nie rekord otwarcia) – pominięto` }];\n}\n\nlet rekordy = [];\ntry {\n    rekordy = typeof body.records === 'string' ? JSON.parse(body.records) : (body.records || []);\n} catch (e) {\n    node.error('Nie można odczytać pola \"records\": ' + e.message);\n    return [odpowiedz, null, null, null, null];\n}\n\nconst wlaczona = flow.get('automatykaWlaczona') !== false;\nconst widziane = flow.get('widziane') || [];\nconst teraz = Date.now();\nconst sceny = [], teksty = [], wyzwalacze = [], logi = [];\n\nfor (const r of rekordy) {\n    const typ = Number(r.recordType);\n    const nazwa = String(r.username || '');\n    const id = `${r.lockDate}-${typ}-${nazwa}`;\n    const osobaKlucz = klucz(nazwa);\n    const miejsce = cfg.osoby.findIndex(o => o.klucz && o.klucz.toLowerCase() === osobaKlucz) + 1;\n    const osoba = miejsce ? cfg.osoby[miejsce - 1] : null;\n    let decyzja;\n\n    if (widziane.includes(id)) decyzja = 'duplikat – pominięto';\n    else if (Number(r.success) !== 1) decyzja = 'nieudana próba – pominięto';\n    else if (!cfg.typyPrzyjscia.includes(typ)) decyzja = 'ten typ nie uruchamia sceny';\n    else if (teraz - Number(r.lockDate) > cfg.maksWiekMinut * 60000) decyzja = 'rekord zbyt stary – pominięto';\n    else if (!osoba) decyzja = `nieznana osoba \"${osobaKlucz}\" – dodaj ją w KONFIGURACJI`;\n    else if (!wlaczona) decyzja = 'automatyka wyłączona z KNX – pominięto';\n    else {\n        decyzja = `OSOBA ${miejsce} (7/3/${miejsce}), SCENA ${osoba.scena}`;\n        if (osoba.scena) sceny.push({ payload: { save_recall: 0, scenenumber: Number(osoba.scena) }, osoba: osoba.nazwa });\n        wyzwalacze.push({ payload: true, miejsce, osoba: osoba.nazwa });\n        teksty.push({ payload: bezOgonkow(osoba.nazwa).substring(0, 14) });\n    }\n    widziane.push(id);\n\n    const czas = new Date(Number(r.lockDate)).toLocaleString('pl-PL');\n    const opoznienie = ((teraz - Number(r.lockDate)) / 1000).toFixed(1);\n    logi.push({\n        payload: `${czas} | ${TYPY[typ] || 'typ ' + typ} | \"${nazwa}\" | ${decyzja} | opóźnienie ${opoznienie} s`,\n        rekord: maskuj(r),\n    });\n}\nflow.set('widziane', widziane.slice(-200));\n\nif (logi.length) {\n    const ostatni = logi[logi.length - 1].payload.split(' | ');\n    node.status({ fill: wyzwalacze.length ? 'green' : 'grey', shape: 'dot', text: `${ostatni[2]}: ${ostatni[3]}` });\n}\nreturn [odpowiedz, sceny, teksty, wyzwalacze, logi];\n",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "outputLabels": [
      "odpowiedź HTTP",
      "scena KNX",
      "tekst KNX",
      "wyzwalacz osoby 1–10",
      "log"
    ],
    "x": 440,
    "y": 260,
    "wires": [
